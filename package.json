{
  "name": "@proca/queue",
  "version": "7.0.0",
  "license": "AGPL-3.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:integration": "tsx src/test.ts",
    "prepare": "husky"
  },
  "keywords": [
    "petition",
    "proca",
    "campaigning",
    "digital-engagement",
    "social-change",
    "nonprofit",
    "civic-tech",
    "mobilisation",
    "advocacy",
    "activism",
    "email-campaign",
    "grassroots"
  ],
  "author": "Marcin Koziej",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@proca/crypto": "^3.4.0",
    "rabbitmq-client": "^5.0.8"
  },
  "gitHead": "635a7c1b39cd036c8d9fe111b3c9fd0c325eada6",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
